{% extends 'base.html.twig' %}

{% block title %}Boutique - MiniShop{% endblock %}

{% block body %}
    <div class="container my-5">
        <h1 class="mb-4">Catégorie : {{ categorie.nom }}</h1>
        <a href="#" class="btn btn-outline-warning">Afficher toutes les catégories</a>

        <div class="row">
            {% for product in categorie.produit %}
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="{{ product.image }}" class="card-img-top" alt="{{ product.nom }}">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title"><a href="{{ path('shop_produit_show', {produit_name: product.nom}) }}">{{ product.nom }}</a></h5>
                            <p class="card-text text-muted">{{ product.description|slice(0, 80) ~ '...' }}</p>
                            <div class="mt-auto">
                                <p class="fw-bold mb-2">{{ product.prix }} €</p>
                                <form action="{{ path('cart_add') }}" method="post">
                                    <input type="hidden" name="produit" value="{{ product.id }}">
                                    <input type="hidden" name="return_url" value="{{ app.request.uri }}">
                                    <button type="submit" class="btn btn-primary w-100">Ajouter au panier 🛒</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <p>Aucun produit disponible pour le catégorie.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
