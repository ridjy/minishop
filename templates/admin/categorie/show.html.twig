{% extends 'base_bo.html.twig' %}

{% block title %}Categorie{% endblock %}

{% block body %}
    <h1>Categorie</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Nom</th>
                <td>{{ categorie.nom }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_categorie_index') }}" class="btn btn-outline-warning">Revenir à la liste</a>

    <a href="{{ path('app_admin_categorie_edit', {'id': categorie.id}) }}" class="btn btn-outline-success">Modifier</a>

    {{ include('admin/categorie/_delete_form.html.twig') }}
{% endblock %}
