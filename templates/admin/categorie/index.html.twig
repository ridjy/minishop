{% extends 'base_bo.html.twig' %}

{% block title %}Liste des categories{% endblock %}

{% block body %}
    <h1>Liste des categories</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for categorie in categories %}
            <tr>
                <td>{{ categorie.nom }}</td>
                <td>
                    <a href="{{ path('app_admin_categorie_show', {'id': categorie.id}) }}" class="btn btn-outline-primary">Afficher</a>
                    <a href="{{ path('app_admin_categorie_edit', {'id': categorie.id}) }}" class="btn btn-outline-success">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Aucune catégorie enregistrée</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {{ pagerfanta(categories) }}
    <a href="{{ path('app_admin_categorie_new') }}" class="btn btn-outline-primary">Ajouter une catégorie</a>
{% endblock %}
