{% extends 'base_bo.html.twig' %}

{% block title %}Liste des clients{% endblock %}

{% block body %}
    <h1>Liste des clients</h1>

    <table class="table">
        <thead>
        <tr>
            <th>Nom</th>

            <th>Prénom</th>
            <th>Adresse mail</th>
            <th>Actif</th>
            <th>Nombre de commandes</th>
            <th>Montant total dépensé sur le site</th>
            <th>actions</th>
        </tr>
        </thead>
        <tbody>
        {% for client in clients %}
            <tr>
                <td>{{ client.lastname }}</td>
                <td>{{ client.firstname }}</td>
                <td>{{ client.email }}</td>
                <td>{{ client.isVerified }}</td>
                <td>{{ client.commandes|length }}</td>
                <td>0</td>
                <td>
                    <a href="{{ path('app_admin_client_show', {'id': client.id}) }}" class="btn btn-outline-primary">Afficher</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Aucun client enregistré</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {{ pagerfanta(clients) }}
{% endblock %}
