{% extends 'base.html.twig' %}

{% block title %}Produit{% endblock %}

{% block body %}
    <h1>Produit</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Nom</th>
                <td>{{ produit.nom }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ produit.description }}</td>
            </tr>
            <tr>
                <th>Prix</th>
                <td>{{ produit.prix }}</td>
            </tr>
            <tr>
                <th>Stock</th>
                <td>{{ produit.stock }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>
                    {% if produit.image %}
                        <img src="{{ asset('uploads/' ~ produit.image) }}" alt="Image du produit" class="img-thumbnail" style="max-width:150px;">
                    {% else %}
                        aucune image du produit
                    {% endif %}
                </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('admin_produit_index') }}" class="btn btn-outline-warning">Revenir à la liste</a>

    <a href="{{ path('app_admin_produit_edit', {'id': produit.id}) }}" class="btn btn-outline-success">Modifier</a>

    {{ include('admin/produit/_delete_form.html.twig') }}
{% endblock %}
